# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_64_char_hex_key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Facebook / Instagram
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_BASE_PRICE_ID=your_base_price_id
STRIPE_UNLIMITED_PRICE_ID=your_unlimited_price_id
NEXT_PUBLIC_STRIPE_BASE_PRICE_ID=your_base_price_id
NEXT_PUBLIC_STRIPE_UNLIMITED_PRICE_ID=your_unlimited_price_id

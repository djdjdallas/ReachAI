# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Instagram (Meta Graph API · Instagram Login) ────────────────────────
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=random_string_you_also_paste_into_meta_webhook_config

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_BASE_PRICE_ID=your_base_price_id
STRIPE_UNLIMITED_PRICE_ID=your_unlimited_price_id

# ── Calendly (inbound webhooks) ─────────────────────────────────────────
CALENDLY_WEBHOOK_SECRET=your_calendly_signing_secret

# ── Google Calendar OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Resend (transactional email) ────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Clinchd <notifications@clinchd.io>

# ── Twilio (SMS alerts) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555550000

# ── PostHog (analytics) ─────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Vercel Cron ─────────────────────────────────────────────────────────
CRON_SECRET=random_string_set_on_vercel_cron

# ── Encryption (AES-256-GCM for stored tokens) ──────────────────────────
# Must be a 64-char hex string (= 32 bytes). Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key

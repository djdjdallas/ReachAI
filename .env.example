# =============================================================================
# Clinchd Environment Variables
# Copy this file to .env.local and fill in your values.
# This is the single canonical example — keep it in sync when adding env vars.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude AI) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (fall back to in-code defaults when unset):
CLASSIFY_INCOMING_MODEL=
DM_INTENT_MODEL=
SUMMARIZE_CONVERSATION_MODEL=

# ── Token Encryption (AES-256-GCM for stored OAuth tokens) ───────────────────
# Must be a 64-char hex string (= 32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Instagram / Meta (Graph API · Instagram Login) ───────────────────────────
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=random-string-you-also-paste-into-meta-webhook-config
# Optional: in NON-production only, requests carrying this value in the
# x-clinchd-dev-bypass header skip HMAC verification (for local simulation
# scripts). NEVER set this in production.
WEBHOOK_DEV_BYPASS_TOKEN=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASE_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...

# ── Calendly OAuth ───────────────────────────────────────────────────────────
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/calendly/callback
# Webhook signing keys are per-user (stored encrypted on the users row), so
# there is no shared webhook secret env var.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# ── Google Calendar OAuth ────────────────────────────────────────────────────
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Clinchd <notifications@clinchd.io>

# ── Twilio (SMS alerts) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555550000

# ── PostHog (analytics) ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Secret for authenticating cron endpoint calls. If unset, cron routes fail
# closed (return 401) — set this in Vercel before relying on the crons.
CRON_SECRET=random-string-set-on-vercel-cron

# ── Admin / Founder gating ───────────────────────────────────────────────────
# Email gated for the intent classifier admin playground and /api/admin/* routes.
ADMIN_EMAIL=you@example.com
# Comma-separated emails treated as founder accounts.
FOUNDER_EMAILS=

# ── Feature flags / kill switches ────────────────────────────────────────────
# Set to "false" to disable the comment intent classifier without a redeploy.
COMMENT_CLASSIFIER_ENABLED=true
# Set to "true" to enable post-media vision enrichment.
VISION_ENABLED=false
# Controls visibility of the comment-to-DM UI surface.
NEXT_PUBLIC_COMMENT_TO_DM_VISIBLE=false

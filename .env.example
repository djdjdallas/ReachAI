# =============================================================================
# Clinchd Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude AI) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Token Encryption ────────────────────────────────────────────────────────
# 256-bit hex key (64 hex chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Instagram / Meta ────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=your-facebook-app-id
INSTAGRAM_APP_SECRET=your-facebook-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASE_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...

# ── Calendly ────────────────────────────────────────────────────────────────
# OAuth credentials from Calendly Developer Portal → OAuth app.
# Redirect URI to register in the app: {NEXT_PUBLIC_APP_URL}/api/auth/calendly/callback
# Webhook signing keys are per-user (returned by Calendly when we register each
# user's subscription) and stored encrypted in users.calendly_webhook_signing_key,
# so there is no shared webhook secret env var.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# ── Google Calendar ─────────────────────────────────────────────────────────
# OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── PostHog Analytics ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cron Jobs ───────────────────────────────────────────────────────────────
# Secret for authenticating cron endpoint calls
CRON_SECRET=your-cron-secret

# ── Admin Gate ──────────────────────────────────────────────────────────────
# Email address gated for the intent classifier admin playground and
# /api/admin/classify routes. Swap without a redeploy.
ADMIN_EMAIL=dominickjerell@gmail.com
